# Copy this file to .env for local dev, and set the same variables in
# DigitalOcean App Platform's environment variables when you create the app
# (these are build-time vars — Astro/Vite injects them into the static build,
# so they must be set BEFORE the build runs, not added afterward).
#
# Get your project API key from PostHog: Project Settings -> Project API Key.
# It's a public, client-side token (starts with "phc_") — safe to expose in
# the browser, not a secret.
PUBLIC_POSTHOG_KEY=phc_sWFWQTWdkRLbunaQGqTQbuZgn4PvUsZ9Uqh3qTrYC47x

# EU Cloud by default, to match the "data stored within the EU" line in the
# privacy policy. Only change this if your PostHog project is on US Cloud
# (https://us.i.posthog.com) or self-hosted.
PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
