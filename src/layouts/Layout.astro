---
import { Image } from 'astro:assets';
import Analytics from '../components/Analytics.astro';
import { APP, ORGANIZATION, SITE_URL, absoluteUrl, getAlternates, getSiblingPath, getTranslationPaths, type Lang } from '../lib/seo';
import { chrome } from '../i18n/chrome';
import logo from '../assets/brand/sidekik-logo.png';

interface Props {
  title: string;
  description: string;
  lang?: Lang;
  path?: string; // e.g. "/features" - used for canonical URL
  ogType?: 'website' | 'article';
  publishedTime?: Date;
  /** Page-specific JSON-LD, emitted alongside the sitewide Organization node. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Overrides the default social preview image. Paths are made absolute. */
  ogImage?: { src: string; width: number; height: number };
  /** Drop the gap above the footer (for pages that end in a full-bleed section). */
  flushFooter?: boolean;
  /** Soft-404 and similar pages that must not be indexed. */
  noindex?: boolean;
}

const {
  title,
  description,
  lang = 'de',
  path = Astro.url.pathname,
  ogType = 'website',
  publishedTime,
  jsonLd,
  ogImage,
  flushFooter = false,
  noindex = false,
} = Astro.props;

const canonicalURL = absoluteUrl(path);
const alternates = getAlternates(path);
const ogLocale = lang === 'en' ? 'en_US' : 'de_DE';
const current = path.replace(/\/$/, '') || '/';
const jsonLdBlocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const ui = chrome(lang);
const otherLang: Lang = lang === 'en' ? 'de' : 'en';
const otherHref = getSiblingPath(path, otherLang);
const translationPaths = getTranslationPaths(path);

const isActive = (href: string) =>
  href === '/' || href === '/en' ? current === href : current === href || current.startsWith(`${href}/`);

// Crawlers do not resolve relative URLs, so the image is always absolute.
const DEFAULT_OG_IMAGE = { src: '/images/social/og-default.jpg', width: 1200, height: 630 };
const social = ogImage ?? DEFAULT_OG_IMAGE;
const socialImageUrl = social.src.startsWith('http') ? social.src : absoluteUrl(social.src);
const organizationLogo = absoluteUrl(ORGANIZATION.logo);

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: ORGANIZATION.name,
  legalName: ORGANIZATION.legalName,
  url: SITE_URL,
  email: ORGANIZATION.email,
  logo: { '@type': 'ImageObject', url: organizationLogo },
  sameAs: [ORGANIZATION.instagram, APP.stores.apple.url, APP.stores.google.url],
};
---

<!doctype html>
<html
  lang={lang}
  data-page-lang={lang}
  data-locale-de={translationPaths?.de}
  data-locale-en={translationPaths?.en}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var de = root.getAttribute('data-locale-de');
        var en = root.getAttribute('data-locale-en');
        var current = root.getAttribute('data-page-lang');
        if (!de || !en || !current) return;
        if (/bot|crawl|spider|slurp|facebookexternalhit|bingpreview/i.test(navigator.userAgent)) return;

        var stored;
        try {
          stored = localStorage.getItem('sidekik_lang');
        } catch (e) {
          stored = null;
        }

        var want;
        if (stored === 'de' || stored === 'en') {
          want = stored;
        } else {
          var langs = navigator.languages && navigator.languages.length
            ? navigator.languages
            : [navigator.language];
          for (var i = 0; i < langs.length; i++) {
            var tag = String(langs[i] || '').toLowerCase();
            if (tag === 'en' || tag.indexOf('en-') === 0) {
              want = 'en';
              break;
            }
            if (tag === 'de' || tag.indexOf('de-') === 0) {
              want = 'de';
              break;
            }
          }
          if (!want) want = 'de';
        }

        var target = want === 'en' ? en : de;
        if (target && want !== current) {
          location.replace(target);
        }
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Instrument+Sans:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <link rel="canonical" href={canonicalURL} />
    )}
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {alternates.map((alt) => (
      <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
    ))}

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Sidekik" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content={String(social.width)} />
    <meta property="og:image:height" content={String(social.height)} />
    <meta property="og:image:alt" content={title} />
    {publishedTime && (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    )}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={title} />

    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} is:inline />
    {jsonLdBlocks.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} is:inline />
    ))}

    <style>
      :root {
        --color-bg: #eef2f7;
        --color-surface: #ffffff;
        --color-text: #0e1116;
        --color-muted: #5a6472;
        --color-primary: #ff2d78;
        --color-primary-dark: #e0155e;
        --color-border: #dde3ec;
        --color-ink: #0e1116;
        --color-ink-soft: #171c24;
        --font-display: 'Outfit', -apple-system, BlinkMacSystemFont, sans-serif;
        --max-width: 1180px;
        color-scheme: light;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        padding: 0;
      }

      body {
        background: var(--color-bg);
        color: var(--color-text);
        font-family: 'Instrument Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto,
          Helvetica, Arial, sans-serif;
        line-height: 1.6;
      }

      a {
        color: var(--color-primary-dark);
      }

      img {
        max-width: 100%;
        height: auto;
      }

      .wrap {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 0 1.25rem;
      }

      header.site-header {
        position: sticky;
        top: 0;
        background: #000;
        z-index: 10;
      }

      .nav-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1.05rem 1.5rem;
        max-width: 1240px;
        margin: 0 auto;
        gap: 1.25rem;
      }

      .logo-mark {
        display: block;
        height: 28px;
        width: auto;
      }

      nav.main-nav {
        margin-left: auto;
      }

      nav.main-nav ul {
        list-style: none;
        display: flex;
        gap: 1.75rem;
        margin: 0;
        padding: 0;
        flex-wrap: wrap;
      }

      nav.main-nav a {
        text-decoration: none;
        color: #fff;
        font-weight: 500;
        font-size: 0.95rem;
      }

      nav.main-nav a:hover {
        color: #fff;
        opacity: 0.8;
      }

      nav.main-nav a[aria-current='page'] {
        color: var(--color-primary);
        opacity: 1;
      }

      .nav-toggle-input {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip: rect(0 0 0 0);
      }

      .nav-toggle {
        display: none;
        appearance: none;
        border: 1px solid #2a3240;
        background: transparent;
        color: #fff;
        border-radius: 8px;
        padding: 0.4rem 0.6rem;
        font-size: 1rem;
        line-height: 1;
        cursor: pointer;
      }

      .nav-toggle-input:focus-visible ~ .nav-toggle {
        outline: 2px solid var(--color-primary);
        outline-offset: 2px;
      }

      .nav-toggle {
        margin-left: 0;
      }

      main {
        min-height: 60vh;
      }

      footer.site-footer {
        margin-top: 4rem;
        background: #080b0f;
        color: #9ba5b4;
        padding: 3rem 0 2rem;
      }

      footer.site-footer.flush {
        margin-top: 0;
      }

      .footer-inner {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 2.5rem;
      }

      .footer-brand-col {
        max-width: 260px;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
      }

      .footer-cols {
        display: flex;
        gap: 3rem;
        flex-wrap: wrap;
      }

      .footer-col {
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
      }

      .footer-col-title {
        color: #4e5866;
        font-size: 0.85rem;
      }

      .footer-links {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 0.55rem;
        margin: 0;
        padding: 0;
      }

      .footer-links a {
        text-decoration: none;
        color: #d6dce4;
        font-size: 0.9rem;
      }

      .footer-links a:hover {
        color: #fff;
      }

      .footer-brand {
        display: inline-block;
      }

      .footer-bottom {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem 1.25rem;
        margin-top: 1.5rem;
      }

      .copyright {
        margin: 0;
        font-size: 0.8rem;
        color: var(--color-muted);
      }

      .lang-switch {
        text-decoration: none;
        color: #d6dce4;
        font-weight: 600;
        font-size: 0.8rem;
        letter-spacing: 0.04em;
        border: 1px solid #2a3240;
        border-radius: 8px;
        padding: 0.35rem 0.55rem;
      }

      .lang-switch:hover {
        color: #fff;
      }

      footer.site-footer .copyright {
        color: #4e5866;
      }

      .cta-button {
        display: inline-block;
        background: var(--color-primary);
        color: #fff;
        padding: 0.7rem 1.4rem;
        border-radius: 10px;
        text-decoration: none;
        font-weight: 700;
      }

      .cta-button:hover {
        background: var(--color-primary-dark);
        color: #fff;
      }

      h1, h2, h3 {
        line-height: 1.15;
        font-family: var(--font-display);
        letter-spacing: -0.02em;
      }

      section {
        margin: 2.5rem 0;
      }

      table {
        border-collapse: collapse;
        width: 100%;
      }

      table td, table th {
        border: 1px solid var(--color-border);
        padding: 0.5rem 0.75rem;
        text-align: left;
      }

      blockquote {
        border-left: 4px solid var(--color-primary);
        margin: 1.25rem 0;
        padding: 0.25rem 1rem;
        color: var(--color-muted);
        font-style: italic;
      }

      @media (max-width: 860px) {
        .nav-toggle {
          display: inline-flex;
          align-items: center;
          justify-content: center;
          margin-left: auto;
        }

        nav.main-nav {
          display: none;
          width: 100%;
          order: 4;
          margin-left: 0;
        }

        nav.main-nav ul {
          flex-direction: column;
          gap: 0;
          padding: 0.5rem 0 0.75rem;
        }

        nav.main-nav a {
          display: block;
          padding: 0.6rem 0;
        }

        .nav-inner {
          flex-wrap: wrap;
        }

        header.site-header:has(.nav-toggle-input:checked) nav.main-nav {
          display: block;
        }
      }

      @media (max-width: 640px) {
        .footer-inner {
          flex-direction: column;
        }
      }
    </style>
  </head>
  <body>
    <header class="site-header">
      <div class="nav-inner">
        <a href={ui.homeHref} aria-label={ui.homeAria}>
          <Image src={logo} alt="Sidekik" class="logo-mark" width={140} loading="eager" />
        </a>
        <input type="checkbox" id="nav-toggle-input" class="nav-toggle-input" />
        <label class="nav-toggle" for="nav-toggle-input" aria-label={ui.menuAria}>☰</label>
        <nav class="main-nav" aria-label={ui.navAria} id="main-nav">
          <ul>
            {ui.nav.map((item) => (
              <li>
                <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer class:list={['site-footer', { flush: flushFooter }]}>
      <div class="wrap footer-inner">
        <div class="footer-brand-col">
          <a class="footer-brand" href={ui.homeHref}>
            <Image src={logo} alt="Sidekik" width={120} />
          </a>
          <p>{ui.footerTagline}</p>
        </div>
        <div class="footer-cols">
          <div class="footer-col">
            <span class="footer-col-title">{ui.productTitle}</span>
            <ul class="footer-links">
              {ui.product.map((item) => (
                <li><a href={item.href}>{item.label}</a></li>
              ))}
            </ul>
          </div>
          <div class="footer-col">
            <span class="footer-col-title">{ui.moreTitle}</span>
            <ul class="footer-links">
              {ui.more.map((item) => (
                <li>
                  <a href={item.href} rel={item.external ? 'noopener' : undefined}>{item.label}</a>
                </li>
              ))}
            </ul>
          </div>
          <div class="footer-col">
            <span class="footer-col-title">{ui.legalTitle}</span>
            <ul class="footer-links">
              {ui.legal.map((item) => (
                <li><a href={item.href}>{item.label}</a></li>
              ))}
            </ul>
          </div>
        </div>
      </div>
      <div class="wrap footer-bottom">
        <p class="copyright">&copy; {new Date().getFullYear()} Sidekik GmbH. {ui.copyright}</p>
        <a
          class="lang-switch"
          href={otherHref}
          hreflang={otherLang}
          lang={otherLang}
          data-lang-pref={otherLang}
        >
          {ui.langSwitch}
        </a>
      </div>
    </footer>
    <script>
      document.querySelector<HTMLAnchorElement>('.lang-switch')?.addEventListener('click', (event) => {
        const pref = (event.currentTarget as HTMLAnchorElement).dataset.langPref;
        if (pref === 'de' || pref === 'en') {
          localStorage.setItem('sidekik_lang', pref);
        }
      });
    </script>

    <Analytics
      message={ui.cookie.message}
      privacyHref={ui.cookie.privacyHref}
      privacyLabel={ui.cookie.privacyLabel}
      accept={ui.cookie.accept}
      decline={ui.cookie.decline}
    />
  </body>
</html>
