---
import { Image } from 'astro:assets';
import Analytics from '../components/Analytics.astro';
import { ORGANIZATION, SITE_URL, absoluteUrl, getAlternates } from '../lib/seo';
import logo from '../assets/brand/sidekik-logo.png';

interface Props {
  title: string;
  description: string;
  lang?: string;
  path?: string; // e.g. "/features" - used for canonical URL
  ogType?: 'website' | 'article';
  publishedTime?: Date;
  /** Page-specific JSON-LD, emitted alongside the sitewide Organization node. */
  jsonLd?: Record<string, unknown>;
  /** Overrides the default social preview image. Paths are made absolute. */
  ogImage?: { src: string; width: number; height: number };
}

const {
  title,
  description,
  lang = 'de',
  path = Astro.url.pathname,
  ogType = 'website',
  publishedTime,
  jsonLd,
  ogImage,
} = Astro.props;

const canonicalURL = absoluteUrl(path);
const alternates = getAlternates(path);
const ogLocale = lang === 'en' ? 'en_US' : 'de_DE';

// Crawlers do not resolve relative URLs, so the image is always absolute.
const DEFAULT_OG_IMAGE = { src: '/images/social/og-default.png', width: 1200, height: 630 };
const social = ogImage ?? DEFAULT_OG_IMAGE;
const socialImageUrl = social.src.startsWith('http') ? social.src : absoluteUrl(social.src);

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: ORGANIZATION.name,
  legalName: ORGANIZATION.legalName,
  url: SITE_URL,
  email: ORGANIZATION.email,
  sameAs: [ORGANIZATION.instagram],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Instrument+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {alternates.map((alt) => (
      <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
    ))}

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Sidekik" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content={String(social.width)} />
    <meta property="og:image:height" content={String(social.height)} />
    <meta property="og:image:alt" content={title} />
    {publishedTime && (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    )}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} is:inline />
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
    )}

    <style>
      :root {
        --color-bg: #eef2f7;
        --color-surface: #ffffff;
        --color-text: #0e1116;
        --color-muted: #5a6472;
        --color-primary: #ff2d78;
        --color-primary-dark: #e0155e;
        --color-border: #dde3ec;
        --color-ink: #0e1116;
        --color-ink-soft: #171c24;
        --font-display: 'Outfit', -apple-system, BlinkMacSystemFont, sans-serif;
        --max-width: 1180px;
        color-scheme: light;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        padding: 0;
      }

      body {
        background: var(--color-bg);
        color: var(--color-text);
        font-family: 'Instrument Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto,
          Helvetica, Arial, sans-serif;
        line-height: 1.6;
      }

      a {
        color: var(--color-primary-dark);
      }

      img {
        max-width: 100%;
        height: auto;
      }

      .wrap {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 0 1.25rem;
      }

      header.site-header {
        position: sticky;
        top: 0;
        background: var(--color-ink);
        z-index: 10;
      }

      .nav-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.9rem 1.25rem;
        max-width: var(--max-width);
        margin: 0 auto;
        gap: 1.25rem;
      }

      .nav-left {
        display: flex;
        align-items: center;
        gap: 2.1rem;
        min-width: 0;
      }

      .logo-mark {
        display: block;
        height: 28px;
        width: auto;
      }

      nav.main-nav ul {
        list-style: none;
        display: flex;
        gap: 1.5rem;
        margin: 0;
        padding: 0;
        flex-wrap: wrap;
      }

      nav.main-nav a {
        text-decoration: none;
        color: #b7bec9;
        font-weight: 500;
        font-size: 0.9rem;
      }

      nav.main-nav a:hover {
        color: #fff;
      }

      .nav-toggle-input {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip: rect(0 0 0 0);
      }

      .nav-toggle {
        display: none;
        appearance: none;
        border: 1px solid #2a3240;
        background: transparent;
        color: #fff;
        border-radius: 8px;
        padding: 0.4rem 0.6rem;
        font-size: 1rem;
        line-height: 1;
        cursor: pointer;
      }

      .nav-toggle-input:focus-visible ~ .nav-toggle {
        outline: 2px solid var(--color-primary);
        outline-offset: 2px;
      }

      .nav-cta {
        white-space: nowrap;
      }

      main {
        min-height: 60vh;
      }

      footer.site-footer {
        margin-top: 4rem;
        background: #080b0f;
        color: #9ba5b4;
        padding: 3rem 0 2rem;
      }

      .footer-inner {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 2.5rem;
      }

      .footer-brand-col {
        max-width: 260px;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
      }

      .footer-cols {
        display: flex;
        gap: 3rem;
        flex-wrap: wrap;
      }

      .footer-col {
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
      }

      .footer-col-title {
        color: #4e5866;
        font-size: 0.85rem;
      }

      .footer-links {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 0.55rem;
        margin: 0;
        padding: 0;
      }

      .footer-links a {
        text-decoration: none;
        color: #d6dce4;
        font-size: 0.9rem;
      }

      .footer-links a:hover {
        color: #fff;
      }

      .footer-brand {
        display: inline-block;
      }

      .copyright {
        margin-top: 1.5rem;
        font-size: 0.8rem;
        color: var(--color-muted);
      }

      footer.site-footer .copyright {
        color: #4e5866;
      }

      .cta-button {
        display: inline-block;
        background: var(--color-primary);
        color: #fff;
        padding: 0.7rem 1.4rem;
        border-radius: 10px;
        text-decoration: none;
        font-weight: 700;
      }

      .cta-button:hover {
        background: var(--color-primary-dark);
        color: #fff;
      }

      h1, h2, h3 {
        line-height: 1.15;
        font-family: var(--font-display);
        letter-spacing: -0.02em;
      }

      section {
        margin: 2.5rem 0;
      }

      table {
        border-collapse: collapse;
        width: 100%;
      }

      table td, table th {
        border: 1px solid var(--color-border);
        padding: 0.5rem 0.75rem;
        text-align: left;
      }

      blockquote {
        border-left: 4px solid var(--color-primary);
        margin: 1.25rem 0;
        padding: 0.25rem 1rem;
        color: var(--color-muted);
        font-style: italic;
      }

      @media (max-width: 860px) {
        .nav-toggle {
          display: inline-flex;
          align-items: center;
          justify-content: center;
        }

        nav.main-nav {
          display: none;
          width: 100%;
          order: 3;
        }

        nav.main-nav ul {
          flex-direction: column;
          gap: 0;
          padding: 0.5rem 0 0.75rem;
        }

        nav.main-nav a {
          display: block;
          padding: 0.6rem 0;
        }

        .nav-inner {
          flex-wrap: wrap;
        }

        header.site-header:has(.nav-toggle-input:checked) nav.main-nav {
          display: block;
        }
      }

      @media (max-width: 640px) {
        .footer-inner {
          flex-direction: column;
        }
      }
    </style>
  </head>
  <body>
    <header class="site-header">
      <div class="nav-inner">
        <div class="nav-left">
          <a href="/" aria-label="Sidekik Startseite">
            <Image src={logo} alt="Sidekik" class="logo-mark" width={140} />
          </a>
          <nav class="main-nav" aria-label="Hauptnavigation" id="main-nav">
            <ul>
              <li><a href="/features">Features</a></li>
              <li><a href="/clubs">Für Clubs</a></li>
              <li><a href="/challenges">Challenges</a></li>
              <li><a href="/blog">Blog</a></li>
              <li><a href="/about">About</a></li>
            </ul>
          </nav>
        </div>
        <input type="checkbox" id="nav-toggle-input" class="nav-toggle-input" />
        <label class="nav-toggle" for="nav-toggle-input" aria-label="Menü öffnen">☰</label>
        <a class="cta-button nav-cta" href="https://app.sidekik.cloud/signup">Gratis starten</a>
      </div>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-inner">
        <div class="footer-brand-col">
          <a class="footer-brand" href="/">
            <Image src={logo} alt="Sidekik" width={120} />
          </a>
          <p>Die App für Gleitschirmpiloten, Hike&amp;Fly und Clubs.</p>
        </div>
        <div class="footer-cols">
          <div class="footer-col">
            <span class="footer-col-title">Produkt</span>
            <ul class="footer-links">
              <li><a href="/features">Features</a></li>
              <li><a href="/clubs">Für Clubs</a></li>
              <li><a href="/challenges">Challenges</a></li>
              <li><a href="/subscription">Abo</a></li>
            </ul>
          </div>
          <div class="footer-col">
            <span class="footer-col-title">Mehr</span>
            <ul class="footer-links">
              <li><a href="/blog">Blog</a></li>
              <li><a href="/about">About</a></li>
              <li><a href="https://www.instagram.com/sidekik_paragliding/" rel="noopener">Instagram</a></li>
              <li><a href="mailto:hi@sidekik.cloud">Kontakt</a></li>
            </ul>
          </div>
          <div class="footer-col">
            <span class="footer-col-title">Rechtliches</span>
            <ul class="footer-links">
              <li><a href="/nutzungsbedingungen">Nutzungsbedingungen</a></li>
              <li><a href="/datenschutzrichtlinie">Datenschutz</a></li>
              <li><a href="/impressum">Impressum</a></li>
              <li><a href="/account-loeschen">Account löschen</a></li>
            </ul>
          </div>
        </div>
      </div>
      <div class="wrap">
        <p class="copyright">&copy; {new Date().getFullYear()} Sidekik GmbH. Alle Rechte vorbehalten.</p>
      </div>
    </footer>

    <Analytics />
  </body>
</html>
