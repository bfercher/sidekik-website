---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import StoreBadges from '../StoreBadges.astro';
import { ratingLine, type Lang } from '../../lib/seo';
import { clubs } from '../../i18n/clubs';
import PhonePair from '../PhonePair.astro';
import heroRelief from '../../assets/pages/hero-relief-bg.png';
import ctaSky from '../../assets/pages/clubs/cta-sky.jpg';

import logoMojo from '../../assets/pages/clubs/logo-mojo.png';
import logoPraebichl from '../../assets/pages/clubs/logo-praebichl.png';
import logoParateam from '../../assets/pages/clubs/logo-parateam-virgen.png';
import logoGoldenEagles from '../../assets/pages/clubs/logo-golden-eagles.png';
import logoSeegeier from '../../assets/pages/clubs/logo-seegeier.png';
import logoCumulus from '../../assets/pages/clubs/logo-cumulus.png';

import shotChallengeA from '../../assets/pages/clubs/shot-challenge-a.png';
import shotChallengeB from '../../assets/pages/clubs/shot-challenge-b.png';
import shotClubA from '../../assets/pages/clubs/shot-club-a.png';
import shotClubB from '../../assets/pages/clubs/shot-club-b.png';
import shotLeaderboardA from '../../assets/pages/clubs/shot-leaderboard-a.png';
import shotLeaderboardB from '../../assets/pages/clubs/shot-leaderboard-b.png';
import shotTaskA from '../../assets/pages/clubs/shot-task-a.png';
import shotTaskB from '../../assets/pages/clubs/shot-task-b.png';
import shotSegment from '../../assets/pages/clubs/shot-segment.png';
import clubmeisterschaft from '../../assets/pages/clubs/clubmeisterschaft.jpg';

const clubLogos = [
  { src: logoMojo, alt: 'Mojo Sportverein' },
  { src: logoPraebichl, alt: 'Soaring Club Präbichl' },
  { src: logoParateam, alt: 'Parateam Virgen' },
  { src: logoGoldenEagles, alt: 'Golden Eagles Alpine Gliders Zillertal' },
  { src: logoSeegeier, alt: 'Seegeier Para- und Hängegleiter Club' },
  { src: logoCumulus, alt: 'Cumulus Paragleiter Eisenwurzen' },
];

interface Props {
  lang: Lang;
  path: string;
}

const { lang, path } = Astro.props;
const copy = clubs(lang);
---

<Layout
  title={copy.title}
  description={copy.description}
  lang={lang}
  path={path}
  flushFooter
>
  <section class="hero full-bleed">
    <div class="full-bleed-inner hero-inner">
      <Image src={heroRelief} alt=" " class="hero-relief" width={900} aria-hidden="true" />
      <div class="hero-copy">
        <h1>{copy.h1Before}<span class="accent">{copy.h1Accent}</span>{copy.h1After}</h1>
        <p class="lead">{copy.lead}</p>
      </div>
      <p class="logo-label">{copy.logoLabel}</p>
      <div class="logo-row">
        {clubLogos.map((logo) => (
          <Image src={logo.src} alt={logo.alt} class="club-logo" width={140} />
        ))}
      </div>
    </div>
  </section>

  <section class="pillars-section">
    <div class="pillars">
      {copy.pillars.map((pillar) => (
        <div class="pillar">
          <span class="pillar-icon" aria-hidden="true">
            {pillar.icon === 'goals' && (
              <svg viewBox="0 0 40 40" fill="none">
                <circle cx="20" cy="20" r="14" stroke="currentColor" stroke-width="2.2" />
                <circle cx="20" cy="20" r="7" stroke="currentColor" stroke-width="2.2" />
                <circle cx="20" cy="20" r="2.2" fill="currentColor" />
              </svg>
            )}
            {pillar.icon === 'group' && (
              <svg viewBox="0 0 40 40" fill="none">
                <circle cx="14" cy="15" r="5" stroke="currentColor" stroke-width="2.2" />
                <circle cx="26" cy="15" r="5" stroke="currentColor" stroke-width="2.2" />
                <path
                  d="M7 30c1.2-4.2 4.2-6.5 7-6.5s5.8 2.3 7 6.5"
                  stroke="currentColor"
                  stroke-width="2.2"
                  stroke-linecap="round"
                />
                <path
                  d="M19 30c1.2-4.2 4.2-6.5 7-6.5s5.8 2.3 7 6.5"
                  stroke="currentColor"
                  stroke-width="2.2"
                  stroke-linecap="round"
                />
              </svg>
            )}
            {pillar.icon === 'learn' && (
              <svg viewBox="0 0 40 40" fill="none">
                <path
                  d="M8 16l12-6 12 6-12 6-12-6z"
                  stroke="currentColor"
                  stroke-width="2.2"
                  stroke-linejoin="round"
                />
                <path d="M14 19.5v6.5c0 1.8 2.7 3.5 6 3.5s6-1.7 6-3.5v-6.5" stroke="currentColor" stroke-width="2.2" />
              </svg>
            )}
          </span>
          <h2>{pillar.title}</h2>
          <p>{pillar.text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="testimonials-section">
    <div class="testimonial-grid">
      {copy.testimonials.map((t) => (
        <figure class="testimonial-card">
          <span class="quote-mark" aria-hidden="true">“</span>
          <blockquote>{t.quote}</blockquote>
          <figcaption>
            <strong>{t.name}</strong>
            <span>{t.role}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section class="feature-block" id="peak-hunt">
    <div class="card feature-row">
      <div class="feature-copy">
        <span class="eyebrow">{copy.peakHunt.eyebrow}</span>
        <h2>{copy.peakHunt.title}</h2>
        <p>{copy.peakHunt.p1}</p>
        <p>{copy.peakHunt.p2}</p>
        <p>{copy.peakHunt.p3}</p>
        <a class="cta-yellow" href={copy.challengesHref}>{copy.peakHunt.cta}</a>
      </div>
      <div class="feature-visual">
        <PhonePair
          front={shotChallengeB}
          back={shotChallengeA}
          frontAlt={copy.peakHunt.frontAlt}
          backAlt={copy.peakHunt.backAlt}
        />
      </div>
    </div>
  </section>

  <section class="feature-block" id="clubmeisterschaft">
    <div class="card feature-row feature-row-flip">
      <div class="feature-visual feature-visual-photo">
        <Image
          src={clubmeisterschaft}
          alt={copy.championship.alt}
          class="photo-shot"
          width={640}
        />
      </div>
      <div class="feature-copy">
        <span class="eyebrow">{copy.championship.eyebrow}</span>
        <h2>{copy.championship.title}</h2>
        <p>{copy.championship.p1}</p>
        <p>{copy.championship.p2}</p>
      </div>
    </div>
  </section>

  <section class="feature-block" id="profil">
    <div class="card feature-row">
      <div class="feature-copy">
        <span class="eyebrow">{copy.profile.eyebrow}</span>
        <h2>{copy.profile.title}</h2>
        <p>{copy.profile.p1}</p>
        <p>{copy.profile.p2}</p>
        <p>{copy.profile.p3}</p>
      </div>
      <div class="feature-visual">
        <PhonePair
          front={shotClubB}
          back={shotClubA}
          frontAlt={copy.profile.frontAlt}
          backAlt={copy.profile.backAlt}
        />
      </div>
    </div>
  </section>

  <section class="feature-block" id="leaderboards">
    <div class="card feature-row feature-row-flip">
      <div class="feature-visual">
        <PhonePair
          front={shotLeaderboardB}
          back={shotLeaderboardA}
          frontAlt={copy.leaderboards.frontAlt}
          backAlt={copy.leaderboards.backAlt}
        />
      </div>
      <div class="feature-copy">
        <span class="eyebrow">{copy.leaderboards.eyebrow}</span>
        <h2>{copy.leaderboards.title}</h2>
        <p>{copy.leaderboards.p1}</p>
        <p>{copy.leaderboards.p2}</p>
        <ul class="feature-list">
          {copy.leaderboards.items.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="feature-block" id="tasks">
    <div class="card feature-row">
      <div class="feature-copy">
        <span class="eyebrow">{copy.tasks.eyebrow}</span>
        <h2>{copy.tasks.title}</h2>
        <p>{copy.tasks.body}</p>
      </div>
      <div class="feature-visual">
        <PhonePair
          front={shotTaskB}
          back={shotTaskA}
          frontAlt={copy.tasks.frontAlt}
          backAlt={copy.tasks.backAlt}
        />
      </div>
    </div>
  </section>

  <section class="feature-block" id="segmente">
    <div class="card feature-row feature-row-flip">
      <div class="feature-visual">
        <Image
          src={shotSegment}
          alt={copy.segments.alt}
          class="shot-segment"
          width={540}
        />
      </div>
      <div class="feature-copy">
        <span class="eyebrow">{copy.segments.eyebrow}</span>
        <h2>{copy.segments.title}</h2>
        <p>{copy.segments.body}</p>
      </div>
    </div>
  </section>

  <section class="pricing-section" id="preise">
    <h2>{copy.pricingTitle}</h2>
    <div class="pricing-grid">
      {copy.plans.map((plan) => (
        <article class="plan">
          <h3>{plan.name}</h3>
          <p class="plan-sub">{plan.sub}</p>
          <p class="plan-price">
            {plan.price}
            {plan.period && <span>{plan.period}</span>}
          </p>
          {plan.note && <p class="plan-note">{plan.note}</p>}
          <ul>
            {plan.features.map((item) => (
              <li>
                <span class="check" aria-hidden="true">✓</span>
                {item}
              </li>
            ))}
          </ul>
          <a class="cta-button plan-cta" href={plan.href}>{plan.cta}</a>
        </article>
      ))}
    </div>

    <div class="addon">
      <div>
        <h3>{copy.addonTitle}</h3>
        <p>{copy.addonText}</p>
      </div>
      <div class="addon-price">
        <strong>{copy.addonPrice}</strong>
        <span>{copy.addonPeriod}</span>
        <a class="cta-button" href="mailto:hi@sidekik.cloud">{copy.addonCta}</a>
      </div>
    </div>

    <p class="pricing-legal">
      {copy.pricingLegal1Before}<a href={copy.subscriptionHref}>{copy.pricingLegal1Link}</a>{copy.pricingLegal1After}
    </p>
    <p class="pricing-legal">{copy.pricingLegal2}</p>
  </section>

  <section class="cta-section full-bleed">
    <Image src={ctaSky} alt=" " class="cta-bg" width={1024} aria-hidden="true" />
    <div class="cta-panel">
      <h2>{copy.ctaTitle}</h2>
      <p>{copy.ctaText}</p>
      <StoreBadges />
      <p class="rating-line">
        <span class="star" aria-hidden="true">★</span> {ratingLine(lang)}
      </p>
    </div>
  </section>
</Layout>

<style>
  .full-bleed {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
  }

  .full-bleed-inner {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 clamp(20px, 5vw, 48px);
  }

  .accent {
    color: var(--color-primary);
  }

  .eyebrow {
    display: block;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .card {
    background: var(--color-surface);
    border-radius: 22px;
    padding: clamp(22px, 3vw, 36px);
  }

  h2 {
    font-size: clamp(28px, 4.4vw, 38px);
    font-weight: 900;
    text-transform: uppercase;
    margin: 0;
  }

  /* Hero */
  .hero {
    background: #000;
    color: #fff;
    margin-top: 0;
    margin-bottom: 0;
    position: relative;
    overflow: hidden;
    z-index: 1;
  }

  .hero-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-top: clamp(56px, 8vw, 96px);
    padding-bottom: clamp(48px, 8vw, 80px);
  }

  .hero-relief {
    position: absolute;
    left: 50%;
    top: 8px;
    transform: translateX(-50%);
    width: min(780px, 92vw);
    max-width: none;
    opacity: 0.45;
    pointer-events: none;
    mask-image: radial-gradient(ellipse at center, #000 40%, transparent 72%);
  }

  .hero-copy {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    max-width: 760px;
  }

  .hero h1 {
    font-size: clamp(32px, 5.2vw, 54px);
    line-height: 1.08;
    letter-spacing: -0.03em;
    font-weight: 800;
    margin: 0;
    text-wrap: balance;
  }

  .hero .lead {
    font-size: clamp(16px, 2vw, 18px);
    line-height: 1.55;
    color: #c8c8c8;
    margin: 0;
    max-width: 560px;
    text-wrap: pretty;
  }

  .logo-label {
    position: relative;
    margin: 36px 0 16px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #9ba5b4;
  }

  .logo-row {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: clamp(16px, 3vw, 36px);
    width: 100%;
    max-width: 920px;
  }

  .club-logo {
    height: 52px;
    width: auto;
    max-width: 140px;
    object-fit: contain;
  }

  /* Pillars */
  .pillars-section {
    margin: 0;
    padding-top: clamp(8px, 2vw, 16px);
  }

  .pillars {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .pillar {
    background: var(--color-surface);
    border-radius: 20px;
    padding: 28px 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .pillar-icon {
    width: 40px;
    height: 40px;
    color: var(--color-primary);
  }

  .pillar-icon svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .pillar h2 {
    font-size: 22px;
    text-transform: none;
  }

  .pillar p {
    margin: 0;
    color: var(--color-muted);
    font-size: 15px;
    line-height: 1.55;
  }

  /* Testimonials */
  .testimonials-section {
    margin: 0;
    padding-top: clamp(16px, 3vw, 28px);
  }

  .testimonial-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .testimonial-card {
    margin: 0;
    background: var(--color-surface);
    border-radius: 20px;
    padding: 24px 26px 28px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .quote-mark {
    font-family: var(--font-display);
    font-size: 64px;
    line-height: 0.7;
    color: #ffc400;
    font-weight: 800;
  }

  .testimonial-card blockquote {
    margin: 0;
    padding: 0;
    border: 0;
    font-style: italic;
    font-size: 15px;
    line-height: 1.55;
    color: var(--color-text);
    text-wrap: pretty;
  }

  .testimonial-card figcaption {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-top: 8px;
    font-size: 13px;
    color: var(--color-muted);
  }

  .testimonial-card figcaption strong {
    color: var(--color-text);
    font-size: 15px;
  }

  /* Feature rows */
  .feature-block {
    padding-top: clamp(16px, 3vw, 28px);
    margin: 0;
  }

  .feature-row {
    display: grid;
    grid-template-columns: 0.95fr 1.05fr;
    gap: clamp(24px, 4vw, 48px);
    align-items: center;
  }

  .feature-row-flip {
    grid-template-columns: 1.05fr 0.95fr;
  }

  .feature-row-flip .feature-visual {
    order: -1;
  }

  .feature-copy {
    display: flex;
    flex-direction: column;
    gap: 14px;
    align-items: flex-start;
  }

  .feature-copy h2 {
    font-size: clamp(26px, 3.6vw, 34px);
    text-wrap: balance;
  }

  .feature-copy p {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-muted);
    text-wrap: pretty;
  }

  .feature-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: 100%;
  }

  .feature-list li {
    position: relative;
    padding-left: 18px;
    font-size: 15px;
    font-weight: 600;
    color: var(--color-text);
  }

  .feature-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 7px;
    height: 7px;
    border-radius: 99px;
    background: var(--color-primary);
  }

  .cta-yellow {
    display: inline-block;
    background: #e7f25a;
    color: #0e1116;
    padding: 0.85rem 1.45rem;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 800;
    font-size: 15px;
    margin-top: 6px;
  }

  .cta-yellow:hover {
    background: #d6e24a;
    color: #0e1116;
  }

  .feature-visual {
    display: flex;
    justify-content: center;
    align-items: center;
    background: transparent;
    padding: 0;
  }

  .feature-visual-photo {
    padding: 0;
  }

  .photo-shot {
    width: 100%;
    height: clamp(340px, 52vw, 520px);
    object-fit: cover;
    object-position: center 40%;
    display: block;
    border-radius: 18px;
    box-shadow: 0 18px 28px rgba(14, 17, 22, 0.18);
  }

  .shot-segment {
    width: min(460px, 100%);
    height: auto;
    display: block;
    filter: drop-shadow(0 18px 28px rgba(14, 17, 22, 0.18));
  }

  /* Pricing */
  .pricing-section {
    margin: 0;
    padding-top: clamp(40px, 6vw, 64px);
  }

  .pricing-section > h2 {
    text-align: center;
    margin-bottom: 28px;
  }

  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .plan {
    background: var(--color-surface);
    border-radius: 22px;
    padding: 28px 24px 24px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .plan h3 {
    margin: 0;
    font-size: 20px;
    font-weight: 800;
    letter-spacing: 0.04em;
  }

  .plan-sub {
    margin: 0;
    color: var(--color-muted);
    font-size: 14px;
  }

  .plan-price {
    margin: 10px 0 0;
    font-size: 32px;
    font-weight: 800;
    font-family: var(--font-display);
    letter-spacing: -0.03em;
  }

  .plan-price span {
    font-size: 15px;
    font-weight: 600;
    color: var(--color-muted);
  }

  .plan-note {
    margin: 0 0 8px;
    font-size: 13px;
    color: var(--color-muted);
  }

  .plan ul {
    list-style: none;
    margin: 12px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
  }

  .plan li {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    font-size: 14px;
    line-height: 1.4;
  }

  .check {
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
    border-radius: 99px;
    background: #e4f8ea;
    color: #1a9a4a;
    font-size: 11px;
    font-weight: 800;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 1px;
  }

  .plan-cta,
  .addon-price .cta-button {
    margin-top: 20px;
    text-align: center;
    border-radius: 999px;
    width: 100%;
    background: var(--color-primary);
    color: #fff;
    text-decoration: none;
    font-weight: 700;
    padding: 0.7rem 1.4rem;
    box-sizing: border-box;
  }

  .plan-cta:hover,
  .addon-price .cta-button:hover {
    background: var(--color-primary-dark);
    color: #fff;
  }

  .addon {
    margin-top: 16px;
    background: var(--color-surface);
    border-radius: 22px;
    padding: 24px 28px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
  }

  .addon h3 {
    margin: 0 0 6px;
    font-size: 20px;
  }

  .addon p {
    margin: 0;
    color: var(--color-muted);
    font-size: 15px;
    max-width: 520px;
  }

  .addon-price {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 8px;
    flex: 0 0 auto;
  }

  .addon-price strong {
    font-size: 24px;
    font-family: var(--font-display);
  }

  .addon-price span {
    font-size: 13px;
    color: var(--color-muted);
  }

  .addon-price .cta-button {
    width: auto;
    margin-top: 4px;
  }

  .pricing-legal {
    font-size: 13px;
    color: var(--color-muted);
    max-width: 820px;
    margin: 16px auto 0;
    text-align: center;
    line-height: 1.55;
  }

  /* CTA */
  .cta-section {
    margin-top: clamp(40px, 6vw, 64px);
    margin-bottom: 0;
    position: relative;
    min-height: clamp(380px, 48vw, 520px);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: var(--color-ink);
  }

  .cta-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
  }

  .cta-panel {
    position: relative;
    z-index: 1;
    background: var(--color-ink);
    color: #fff;
    border-radius: 24px;
    padding: clamp(32px, 5vw, 48px) clamp(24px, 4vw, 40px);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    text-align: center;
    max-width: 520px;
    margin: clamp(32px, 5vw, 56px) 20px;
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.35);
  }

  .cta-section h2 {
    font-size: clamp(28px, 5vw, 42px);
