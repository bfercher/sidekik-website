---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import StoreBadges from '../StoreBadges.astro';
import PhonePair from '../PhonePair.astro';
import heroRelief from '../../assets/pages/hero-relief-bg.png';
import trackingLive from '../../assets/pages/feature-tracking-live.png';
import trackingStart from '../../assets/pages/feature-tracking-start.png';
import onAirMap from '../../assets/pages/feature-onair-map.png';
import onAirHome from '../../assets/pages/feature-onair-home.png';
import shareAdventure from '../../assets/pages/feature-share-adventure.png';
import rankingShot from '../../assets/pages/feature-ranking.png';
import segmentsShot from '../../assets/pages/feature-segments.png';
import communityShot from '../../assets/pages/feature-community.png';
import hikeFlyShot from '../../assets/pages/feature-hike-fly.png';
import clubChallengeShot from '../../assets/pages/feature-club-challenge.png';
import missionShot from '../../assets/pages/feature-mission.png';
import liveWindHistory from '../../assets/pages/feature-livewind-history.png';
import liveWindMap from '../../assets/pages/feature-livewind-map.png';
import statsShot from '../../assets/pages/feature-stats.png';
import ctaSky from '../../assets/pages/feature-cta-sky.jpg';
import logoGarmin from '../../assets/brand/logo-garmin.jpg';
import logoSuunto from '../../assets/brand/logo-suunto.png';
import logoXcontest from '../../assets/brand/logo-xcontest.png';
import { ratingLine, type Lang } from '../../lib/seo';
import { features } from '../../i18n/features';

interface Props {
  lang: Lang;
  path: string;
}

const { lang, path } = Astro.props;
const copy = features(lang);
---

<Layout
  title={copy.title}
  description={copy.description}
  lang={lang}
  path={path}
  flushFooter
>
  <section class="hero full-bleed">
    <div class="full-bleed-inner hero-inner">
      <Image src={heroRelief} alt=" " class="hero-relief" width={900} aria-hidden="true" />
      <div class="hero-copy">
        <h1>{copy.h1Before}<span class="accent">{copy.h1Accent}</span>{copy.h1After}</h1>
        <p class="lead">{copy.lead}</p>
      </div>
    </div>
  </section>

  <section class="feature-block" id="tracking">
    <div class="card feature-row">
      <div class="feature-visual">
        <PhonePair
          front={trackingLive}
          back={trackingStart}
          frontAlt={copy.tracking.frontAlt}
          backAlt={copy.tracking.backAlt}
          smallBack
          eager
        />
      </div>
      <div class="feature-copy">
        <span class="eyebrow">{copy.tracking.eyebrow}</span>
        <h2>{copy.tracking.title}</h2>
        <p>{copy.tracking.body}</p>
        <div class="chip-row">
          {copy.tracking.chips.map((chip) => <span class="chip">{chip}</span>)}
        </div>
      </div>
    </div>
  </section>

  <section class="feature-block" id="on-air">
    <div class="card feature-row feature-row-flip">
      <div class="feature-visual">
        <PhonePair
          front={onAirMap}
          back={onAirHome}
          frontAlt={copy.onAir.frontAlt}
          backAlt={copy.onAir.backAlt}
          smallBack
        />
      </div>
      <div class="feature-copy">
        <span class="eyebrow">{copy.onAir.eyebrow}</span>
        <h2>{copy.onAir.title}</h2>
        <p>{copy.onAir.p1}</p>
        <p>{copy.onAir.p2}</p>
        <div class="chip-row">
          {copy.onAir.chips.map((chip) => <span class="chip">{chip}</span>)}
        </div>
      </div>
    </div>
  </section>

  <section class="feature-block" id="livewind">
    <div class="card feature-row">
      <div class="feature-visual">
        <PhonePair
          front={liveWindHistory}
          back={liveWindMap}
          frontAlt={copy.livewind.frontAlt}
          backAlt={copy.livewind.backAlt}
          smallBack
        />
      </div>
      <div class="feature-copy">
        <span class="eyebrow">{copy.livewind.eyebrow}</span>
        <h2>{copy.livewind.title}</h2>
        <p>{copy.livewind.p1}</p>
        <p>{copy.livewind.p2}</p>
        <div class="chip-row">
          {copy.livewind.chips.map((chip) => <span class="chip">{chip}</span>)}
        </div>
        <a class="text-link" href={copy.livewind.href}>{copy.livewind.link}</a>
      </div>
    </div>
  </section>

  <section class="feature-block" id="share">
    <div class="card feature-row feature-row-flip">
      <div class="feature-visual feature-visual-share">
        <Image
          src={shareAdventure}
          alt={copy.share.alt}
          width={944}
          class="shot shot-share"
        />
      </div>
      <div class="feature-copy">
        <span class="eyebrow">{copy.share.eyebrow}</span>
        <h2>{copy.share.title}</h2>
        <p>{copy.share.body}</p>
        <div class="chip-row">
          {copy.share.chips.map((chip) => <span class="chip">{chip}</span>)}
        </div>
        <div class="partner-row">
          <Image src={logoGarmin} alt="Garmin" class="partner-logo" width={120} />
          <Image src={logoSuunto} alt="Suunto" class="partner-logo partner-logo-suunto" width={102} />
          <Image src={logoXcontest} alt="XContest" class="partner-logo partner-logo-xc" width={40} />
        </div>
      </div>
    </div>
  </section>

  <section class="feature-block" id="leaderboard">
    <div class="card card-dark feature-row">
      <div class="feature-visual feature-visual-on-dark">
        <Image
          src={rankingShot}
          alt={copy.leaderboard.alt}
          width={582}
          class="shot shot-wide"
        />
      </div>
      <div class="feature-copy">
        <span class="eyebrow">{copy.leaderboard.eyebrow}</span>
        <h2>{copy.leaderboard.title}</h2>
        <p class="muted-on-dark">{copy.leaderboard.p1}</p>
        <p class="muted-on-dark">{copy.leaderboard.p2}</p>
        <div class="xp-widget">
          <div class="xp-row">
            <span>{copy.leaderboard.xpSeason}</span>
            <span>{copy.leaderboard.xpScore}</span>
          </div>
          <div class="xp-bar">
            <div class="xp-bar-fill"></div>
          </div>
          <div class="xp-row xp-row-small">
            <span>{copy.leaderboard.xpRank}</span>
            <span>{copy.leaderboard.xpNext}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="feature-block" id="segmente">
    <div class="card feature-row feature-row-flip">
      <div class="feature-visual feature-visual-phone">
        <Image
          src={segmentsShot}
          alt={copy.segments.alt}
          width={383}
          class="shot shot-phone"
        />
      </div>
      <div class="feature-copy">
        <span class="eyebrow">{copy.segments.eyebrow}</span>
        <h2>{copy.segments.title}</h2>
        <p>{copy.segments.body}</p>
        <div class="chip-row">
          {copy.segments.chips.map((chip) => <span class="chip">{chip}</span>)}
        </div>
      </div>
    </div>
  </section>

  <section class="feature-block" id="community">
    <div class="card feature-row">
      <div class="feature-visual feature-visual-phone">
        <Image
          src={communityShot}
          alt={copy.community.alt}
          width={400}
          class="shot shot-phone"
        />
      </div>
      <div class="feature-copy">
        <span class="eyebrow">{copy.community.eyebrow}</span>
        <h2>{copy.community.title}</h2>
        <p>{copy.community.body}</p>
        <div class="chip-row">
          {copy.community.chips.map((chip) => <span class="chip">{chip}</span>)}
        </div>
      </div>
    </div>
  </section>

  <section class="feature-block" id="hike-fly">
    <div class="card feature-row">
      <div class="feature-visual feature-visual-phone">
        <Image
          src={hikeFlyShot}
          alt={copy.hikeFly.alt}
          width={400}
          class="shot shot-phone"
        />
      </div>
      <div class="feature-copy">
        <span class="eyebrow">{copy.hikeFly.eyebrow}</span>
        <h2>{copy.hikeFly.title}</h2>
        <p>{copy.hikeFly.p1}</p>
        <p>{copy.hikeFly.p2}</p>
      </div>
    </div>
  </section>

  <section class="feature-block" id="statistiken">
    <div class="card feature-row feature-row-flip">
      <div class="feature-visual">
        <PhonePair
          front={statsShot}
          frontAlt={copy.stats.frontAlt}
        />
      </div>
      <div class="feature-copy">
        <span class="eyebrow">{copy.stats.eyebrow}</span>
        <h2>{copy.stats.title}</h2>
        <p>{copy.stats.body}</p>
        <div class="chip-row">
          {copy.stats.chips.map((chip) => <span class="chip">{chip}</span>)}
        </div>
        <a class="text-link" href={copy.stats.href}>{copy.stats.link}</a>
      </div>
    </div>
  </section>

  <section class="feature-block" id="clubs">
    <div class="card card-dark feature-row">
      <div class="feature-visual feature-visual-on-dark">
        <PhonePair
          front={clubChallengeShot}
          back={missionShot}
          frontAlt={copy.clubs.frontAlt}
          backAlt={copy.clubs.backAlt}
          smallBack
        />
      </div>
      <div class="feature-copy">
        <span class="eyebrow">{copy.clubs.eyebrow}</span>
        <h2>{copy.clubs.titleBefore}<span class="accent">{copy.clubs.titleAccent}</span></h2>
        <p class="muted-on-dark">{copy.clubs.p1}</p>
        <p class="muted-on-dark">{copy.clubs.p2}</p>
        <a class="text-link" href={copy.clubsHref}>{copy.clubs.link}</a>
      </div>
    </div>
  </section>

  <section class="cta-section full-bleed">
    <Image src={ctaSky} alt=" " class="cta-bg" width={1024} aria-hidden="true" />
    <div class="cta-panel">
      <h2>{copy.ctaTitle}</h2>
      <p>{copy.ctaText}</p>
      <StoreBadges />
      <p class="rating-line"><span class="star" aria-hidden="true">★</span> {ratingLine(lang)}</p>
    </div>
  </section>
</Layout>

<style>
  .full-bleed {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
  }

  .full-bleed-inner {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 clamp(20px, 5vw, 48px);
  }

  h2 {
    font-size: clamp(28px, 4.4vw, 38px);
    font-weight: 900;
    text-transform: uppercase;
    margin: 0;
  }

  .eyebrow {
    display: block;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .card {
    background: var(--color-surface);
    border-radius: 22px;
    padding: clamp(22px, 3vw, 36px);
  }

  .card-dark {
    background: var(--color-ink);
    color: #fff;
  }

  .muted-on-dark {
    color: #9ba5b4;
    font-size: 15px;
    line-height: 1.55;
    margin: 0;
  }

  .accent {
    color: var(--color-primary);
  }

  /* Hero */
  .hero {
    background: #000;
    color: #fff;
    margin-top: 0;
    margin-bottom: 0;
    position: relative;
    overflow: hidden;
    z-index: 1;
  }

  .hero-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-top: clamp(56px, 8vw, 96px);
    padding-bottom: clamp(64px, 10vw, 108px);
  }

  .hero-relief {
    position: absolute;
    left: 50%;
    top: 8px;
    transform: translateX(-50%);
    width: min(780px, 92vw);
    max-width: none;
    opacity: 0.45;
    pointer-events: none;
    mask-image: radial-gradient(ellipse at center, #000 40%, transparent 72%);
  }

  .hero-copy {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    max-width: 760px;
  }

  .hero h1 {
    font-size: clamp(32px, 5.2vw, 54px);
    line-height: 1.08;
    letter-spacing: -0.03em;
    font-weight: 800;
    margin: 0;
    text-wrap: balance;
    text-transform: none;
  }

  .hero .lead {
    font-size: clamp(16px, 2vw, 18px);
    line-height: 1.55;
    color: #c8c8c8;
    margin: 0;
    max-width: 560px;
    text-wrap: pretty;
  }

  /* Feature rows */
  .feature-block {
    padding-top: clamp(24px, 4vw, 40px);
    margin: 0;
  }

  .feature-row {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(24px, 4vw, 48px);
    align-items: center;
  }

  .feature-row-flip {
    grid-template-columns: 0.95fr 1.05fr;
  }

  .feature-row-flip .feature-visual {
    order: 2;
  }

  .feature-copy {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .feature-copy h2 {
    font-size: clamp(26px, 3.6vw, 34px);
    font-weight: 800;
    text-transform: none;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .feature-copy p {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-muted);
    text-wrap: pretty;
  }

  .card-dark .feature-copy p {
    color: #9ba5b4;
  }

  .chip-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .chip {
    background: var(--color-bg);
    padding: 8px 14px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 500;
  }

  .card-dark .chip {
    background: var(--color-ink-soft);
    color: #fff;
  }

  .feature-visual {
    display: flex;
    justify-content: center;
    align-items: center;
    background: transparent;
    padding: 0;
  }

  .feature-visual-phone {
    justify-self: center;
    width: fit-content;
    max-width: 100%;
  }

  .feature-visual-on-dark {
    background: transparent;
  }

  .feature-visual-map {
    background: transparent;
    padding: 0;
  }

  .shot {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
  }

  .shot-phone {
    max-height: clamp(400px, 62vh, 560px);
    width: auto;
    filter: drop-shadow(0 18px 28px rgba(14, 17, 22, 0.18));
  }

  .shot-wide {
    width: 100%;
    max-height: clamp(340px, 56vh, 500px);
    object-fit: contain;
    filter: drop-shadow(0 18px 28px rgba(14, 17, 22, 0.18));
  }

  .shot-map {
    width: 100%;
    border-radius: 18px;
    box-shadow: 0 18px 28px rgba(14, 17, 22, 0.12);
  }

  .feature-visual-share {
    overflow: visible;
  }

  .shot-share {
    width: 100%;
    max-height: clamp(380px, 62vh, 560px);
    object-fit: contain;
    filter: drop-shadow(0 18px 28px rgba(14, 17, 22, 0.18));
  }

  .partner-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 4px;
  }

  .partner-logo {
    height: 28px;
    width: auto;
    object-fit: contain;
  }

  .partner-logo-xc {
    height: 36px;
    width: 36px;
  }

  .partner-logo-suunto {
    height: 40px;
    width: auto;
    border-radius: 8px;
  }

  .xp-widget {
    background: var(--color-ink-soft);
    border-radius: 12px;
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 4px;
  }

  .xp-row {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 13px;
    color: #9ba5b4;
  }

  .xp-row-small {
    font-size: 12px;
    color: #6f7a8a;
  }

  .xp-bar {
    height: 8px;
    border-radius: 99px;
    background: #232a35;
    overflow: hidden;
  }

  .xp-bar-fill {
    width: 62%;
    height: 100%;
    background: var(--color-primary);
  }

  .text-link {
    font-size: 15px;
    font-weight: 700;
    color: var(--color-primary);
    text-decoration: none;
    margin-top: 4px;
  }

  .text-link:hover {
    opacity: 0.85;
  }

  /* CTA */
  .cta-section {
    margin-top: clamp(40px, 6vw, 64px);
    margin-bottom: 0;
    position: relative;
    min-height: clamp(380px, 48vw, 520px);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: var(--color-ink);
  }

  .cta-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
    z-index: 0;
  }

  .cta-section::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.12), rgba(0, 0, 0, 0.4));
    z-index: 1;
    pointer-events: none;
  }

  .cta-panel {
    position: relative;
    z-index: 2;
    background: var(--color-ink);
    color: #fff;
    border-radius: 24px;
    padding: clamp(32px, 5vw, 48px) clamp(24px, 4vw, 40px);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    text-align: center;
    max-width: 520px;
    margin: clamp(32px, 5vw, 56px) 20px;
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.35);
  }

  .cta-section h2 {
    font-size: clamp(28px, 5vw, 42px);
    letter-spacing: -0.035em;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .cta-section p {
    margin: 0;
    font-size: 17px;
    color: #9ba5b4;
  }

  .rating-line {
    margin: 4px 0 0;
    font-size: 15px;
    color: #fff;
  }

  .rating-line .star {
    color: #ffc400;
    margin-right: 4px;
  }

  @media (max-width: 860px) {
    .feature-row,
    .feature-row-flip {
      grid-template-columns: 1fr;
    }

    .feature-row-flip .feature-visual {
      order: 0;
    }

    .hero-inner {
      padding-top: clamp(40px, 8vw, 64px);
      padding-bottom: clamp(48px, 10vw, 72px);
    }

    .shot-phone {
      max-height: 440px;
    }
  }
</style>
