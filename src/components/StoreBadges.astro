---
import badgeAppStore from '../assets/brand/badge-app-store.svg?url';
import badgeGooglePlay from '../assets/brand/badge-google-play.svg?url';

interface Props {
  eager?: boolean;
  align?: 'center' | 'start';
}

const { eager = false, align = 'center' } = Astro.props;

const appStoreUrl =
  'https://apps.apple.com/gb/app/sidekik-paragliding-hike-fly/id6738481976?platform=iphone';
const playStoreUrl = 'https://play.google.com/store/apps/details?id=com.armadaar5org.sidekikapp';
---

<div class:list={['store-badges', { 'store-badges-start': align === 'start' }]}>
  <a href={appStoreUrl} rel="noopener">
    <img
      src={badgeAppStore}
      alt="Download on the App Store"
      width="162"
      height="54"
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
    />
  </a>
  <a href={playStoreUrl} rel="noopener">
    <img
      src={badgeGooglePlay}
      alt="Get it on Google Play"
      width="182"
      height="54"
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
    />
  </a>
</div>

<style>
  .store-badges {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
  }

  .store-badges-start {
    justify-content: flex-start;
  }

  .store-badges a {
    display: block;
    line-height: 0;
    transition: opacity 0.15s ease;
  }

  .store-badges a:hover {
    opacity: 0.88;
  }

  .store-badges img {
    height: 54px;
    width: auto;
    object-fit: contain;
    display: block;
  }
</style>
