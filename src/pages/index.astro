---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import heroRelief from '../assets/pages/hero-relief-bg.png';
import appScreenshotFeed from '../assets/pages/app-screenshot-feed.png';
import appScreenshotLeaderboard from '../assets/pages/app-screenshot-leaderboard.png';
import trackingScreens from '../assets/pages/app-screenshots-hero.png';
import clubSegments from '../assets/pages/club-segments.png';
import { APP, SITE_URL, ratingValueLocalized } from '../lib/seo';

const rating = ratingValueLocalized();

// Declared on the homepage rather than sitewide because this is the page that
// visibly shows the rating, which is a condition for the rating markup.
const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: APP.name,
  url: SITE_URL,
  applicationCategory: 'SportsApplication',
  operatingSystem: 'iOS, Android',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'EUR',
  },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: APP.ratingValue,
    bestRating: '5',
    ratingCount: APP.ratingCount,
  },
};

const appStoreUrl = 'https://apps.apple.com/gb/app/sidekik-paragliding-hike-fly/id6738481976?platform=iphone';
const playStoreUrl = 'https://play.google.com/store/apps/details?id=com.armadaar5org.sidekikapp';
const signupUrl = 'https://app.sidekik.cloud/signup';

const whyPoints = [
  'Setze dir Ziele und miss den Fortschritt.',
  'Flüge und Hike&Fly Abenteuer aufzeichnen und teilen.',
  'Support beim Erreichen deiner Ziele in der Luft.',
  'Fordere deine Kollegen bei spannenden Challenges heraus.',
];

const trackingChips = [
  'Hike & Fly Tracking',
  'Lufträume (OpenAIP)',
  'Kabel & Hindernisse',
  'Thermikkarte',
  'Wegpunkte-Assistent',
  'Live Windwerte',
];

const clubChips = ['Peak Hunt Challenge', 'Hike & Fly Challenge', 'Tasks & Wettbewerbe', 'Club-Segmente'];

const testimonials = [
  {
    quote:
      'Sidekik bringt unsere Piloten im Zillertal weg von den klassischen Rennstrecken, hin zu neuen kreativen Routen und neuen Abenteuern.',
    name: 'Bene Dornauer',
    role: 'Red Bull X-Alps Finisher 2025',
  },
  {
    quote: 'Die Peak Hunt Challenge motiviert mich voll, weil sie mich einfach auf neue Ideen und Berge bringt.',
    name: 'Nicole Heimberger',
    role: 'österr. XC Staatsmeisterin',
  },
  {
    quote: 'Sidekik hat alle unsere Club-Mitglieder zu besseren Piloten gemacht.',
    name: 'Robert Assmair',
    role: 'Parateam Virgen',
  },
];

const faqs = [
  {
    q: 'Welches Equipment brauche ich?',
    a: 'Mit der Sidekik App trackst du Flüge und Hike&Fly Abenteuer und lädst sie direkt hoch. Du kannst auch Wegpunkte exportieren und dein GPS Vario oder andere Flugapps (XC Track, FlySkyHy, SeeYou Navigator) verwenden – die .IGC Datei lädst du dann hoch, oder du verknüpfst XContest, Garmin Connect oder Suunto für automatischen Import.',
  },
  {
    q: 'Ist Sidekik für Piloten kostenlos?',
    a: 'Sidekik ist in der Basisversion kostenlos. Zusätzliche Funktionen gibt es über ein monatliches oder jährliches Abo.',
  },
  {
    q: 'Ist Sidekik für Clubs und Vereine kostenlos?',
    a: 'Registrierte Mitglieder können kostenlos einen Club erstellen, dessen Mitglieder verwalten und eine Challenge pro Jahr über Sidekik veranstalten. Tasks und erweiterte Auswertungen gibt es im Club-Abo.',
  },
  {
    q: 'Wie funktioniert die Club-Challenge?',
    a: "15–30 markante Wegpunkte, ein Zeitraum, automatische Auswertung deiner hochgeladenen Flüge – Punkte, Bonuspunkte, Leaderboard.",
  },
  {
    q: 'Ist Sidekik nur für erfahrene Piloten?',
    a: 'Nein – ganz im Gegenteil. Sidekik ist für alle Pilot:innen mit Lizenz, die regelmäßig fliegen und dabei motiviert bleiben wollen. Egal ob du gerade erst deinen A-Schein gemacht hast oder schon 100+ XC-Flüge hinter dir hast: Wenn du Lust hast, neue Flugziele zu entdecken, Fortschritte zu sehen und deine Abenteuer zu teilen, bist du bei Sidekik genau richtig.',
  },
  {
    q: 'Ich fliege (noch) keine langen XC-Strecken – bringt mir die App trotzdem was?',
    a: 'Ja! Du kannst mit Sidekik Hike&Fly-Ziele sammeln, an Challenges teilnehmen, Sidekik als dein Flugbuch verwenden, deine Höhenmeter, Airtime & Fortschritte verfolgen und dich von Flügen anderer inspirieren lassen. Schon kleine Fortschritte werden sichtbar – und motivieren zum Dranbleiben.',
  },
  {
    q: 'Welche Hike&Fly Funktionen gibt es?',
    a: 'Wenn du eine Aktivität hochlädst, erkennt Sidekik automatisch, welche Abschnitte du geflogen und welche du zu Fuß zurückgelegt hast. Diese werden auf der Karte farblich unterschiedlich dargestellt. So erhältst du eine eigene Hike&Fly-Statistik, in der Flug- und Gehstrecken separat ausgewertet werden.',
  },
  {
    q: 'Kann ich meine Flüge von XContest importieren?',
    a: 'Ja, du kannst dein Sidekik Konto mit deinem XContest Konto verbinden und die Flüge von dort importieren. Wichtig ist nur, dass du sie am selben Tag an dem du geflogen bist noch bei XContest einreichst. Ältere Flüge können nicht importiert werden.',
  },
  {
    q: 'Kann ich meine Flüge von DHV XC importieren?',
    a: 'Das geht leider noch nicht. Es gibt derzeit noch keine Schnittstelle für Drittanbieter, an der Sidekik andocken könnte. Du kannst aber die XContest Verknüpfung verwenden, oder deine Flüge als .IGC oder .GPX Datei hochladen.',
  },
  {
    q: 'Ich verwende eine Fitness Uhr (Garmin, Suunto, etc.) für Hike&Fly Tracking. Wie kann ich diese mit Sidekik verwenden?',
    a: 'Du kannst in den App-Einstellungen deinen Garmin Connect oder Suunto Account direkt mit Sidekik verknüpfen. Bei Suunto kannst du nach erfolgreicher Verknüpfung Aktivitäten vom Typ Hike, Paragliding, Trail-Run, Skitour importieren. Bei Garmin lassen sich Aktivitäten vom Typ Hike, Mountaineering oder Trail-Run importieren.',
  },
];
---

<Layout
  title="Sidekik | Die App für Gleitschirmpiloten und Clubs"
  description="Tracke deine Hike&Fly- und XC-Abenteuer, setze und erreiche deine fliegerischen Ziele – gemeinsam mit deinen Freunden und Clubkollegen."
  lang="de"
  path="/"
  jsonLd={appSchema}
>
  <section class="hero full-bleed">
    <div class="full-bleed-inner hero-inner">
      <Image src={heroRelief} alt="" class="hero-relief" width={900} aria-hidden="true" />
      <div class="hero-copy">
        <span class="rating-pill">★★★★★ <b>{rating}</b> · 2.500+ Piloten · 200+ Clubs</span>
        <h1>Bring dein Fliegen aufs <span class="accent">nächste Level</span></h1>
        <p class="lead">
          Tracke deine Hike&amp;Fly- und XC-Abenteuer, setze und erreiche deine fliegerischen Ziele –
          gemeinsam mit deinen Freunden und Clubkollegen.
        </p>
        <div class="store-badges">
          <a class="store-badge" href={appStoreUrl} rel="noopener">
            <span class="store-eyebrow">Laden im</span>
            <span class="store-name">App Store</span>
          </a>
          <a class="store-badge" href={playStoreUrl} rel="noopener">
            <span class="store-eyebrow">Jetzt bei</span>
            <span class="store-name">Google Play</span>
          </a>
        </div>
      </div>
      <div class="hero-phones">
        <Image
          src={appScreenshotFeed}
          alt="Sidekik App: Feed mit Flügen und Hike&Fly Abenteuern"
          class="phone phone-down"
          width={230}
          loading="eager"
          fetchpriority="high"
        />
        <Image
          src={appScreenshotLeaderboard}
          alt="Sidekik App: Club-Leaderboard und XP"
          class="phone phone-up"
          width={230}
          loading="eager"
        />
      </div>
    </div>
  </section>

  <section class="why">
    <h2>Warum Sidekik?</h2>
    <div class="why-grid">
      {whyPoints.map((point, i) => (
        <div class="why-card">
          <span class="why-index">{String(i + 1).padStart(2, '0')}</span>
          <p>{point}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="feature-section" id="features">
    <div class="feature-grid">
      <div class="card feature-card-tracking">
        <span class="eyebrow">Tracking</span>
        <h3>Unterstützung in der Luft</h3>
        <div class="chip-row">
          {trackingChips.map((chip) => <span class="chip">{chip}</span>)}
        </div>
        <Image src={trackingScreens} alt="Sidekik App Screens" class="tracking-shot" width={940} />
      </div>
      <div class="feature-stack">
        <div class="card card-dark">
          <span class="eyebrow">XP &amp; Level</span>
          <h3>Klettere im Leaderboard</h3>
          <p class="muted-on-dark">
            XP für Strecke, Airtime und H&amp;F-Dauer. Die besten 10 deines Clubs treten gegen andere Clubs an.
          </p>
          <div class="xp-widget">
            <div class="xp-row">
              <span>Season 2025</span>
              <span>7.960 XP · LVL 2</span>
            </div>
            <div class="xp-bar">
              <div class="xp-bar-fill"></div>
            </div>
            <div class="xp-row xp-row-small">
              <span>4.000 XP</span>
              <span>1.040 XP bis LVL 3</span>
            </div>
          </div>
        </div>
        <div class="card feature-card-segments">
          <span class="eyebrow">Segmente</span>
          <h3>Hol dir die Krone</h3>
          <p>Vergleiche deine Route mit der Bestzeit, sieh dir Ideallinien und Schlüsselstellen an.</p>
          <Image src={clubSegments} alt="Segmente" class="segments-shot" width={340} />
        </div>
      </div>
    </div>
  </section>

  <section class="clubs-section" id="clubs">
    <div class="card clubs-card">
      <div class="clubs-copy">
        <span class="eyebrow">Für Clubs</span>
        <h2>200+ Clubs fliegen schon gemeinsam</h2>
        <p>
          Erstellt eure eigenen Herausforderungen und Flugaufgaben. Teilt eure Flüge und Hike&amp;Flys
          untereinander und motiviert euch gegenseitig – die Auswertung macht Sidekik automatisch.
        </p>
        <div class="chip-row chip-row-dark">
          {clubChips.map((chip) => <span class="chip chip-dark">{chip}</span>)}
        </div>
        <a class="text-link" href="/clubs">Alles für Clubs ansehen →</a>
      </div>
      <div class="leaderboard-widget">
        <div class="leaderboard-head">
          <span class="leaderboard-title">Leaderboard</span>
          <span class="leaderboard-sub">Gipfel Cup 2025</span>
        </div>
        <div class="leaderboard-row">
          <span class="rank rank-gold">1</span>
          <span class="rank-name">Wolfgang Raffler</span>
          <span class="rank-score">135,00</span>
        </div>
        <div class="leaderboard-row">
          <span class="rank rank-silver">2</span>
          <span class="rank-name">Peter Lang</span>
          <span class="rank-score">133,00</span>
        </div>
        <div class="leaderboard-row">
          <span class="rank rank-bronze">3</span>
          <span class="rank-name">Herbert Hauser</span>
          <span class="rank-score">133,00</span>
        </div>
        <div class="leaderboard-row leaderboard-row-you">
          <span class="rank rank-you">4</span>
          <span class="rank-name">Du</span>
          <span class="rank-score">128,00</span>
        </div>
        <div class="leaderboard-meta">
          <span>253 Flüge</span>
          <span>·</span>
          <span>61h 35m</span>
          <span>·</span>
          <span>451 WPs</span>
        </div>
      </div>
    </div>
  </section>

  <section class="testimonials-section" id="challenges">
    <div class="testimonial-grid">
      {testimonials.map((t, i) => (
        <figure class:list={['testimonial-card', { dark: i === 0, accent: i === 2 }]}>
          <p>&bdquo;{t.quote}&ldquo;</p>
          <figcaption>{t.name} · {t.role}</figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section class="faq-section">
    <h2>FAQ</h2>
    <div class="faq-grid">
      {faqs.map((item, i) => (
        <details class="faq-item" open={i === 0}>
          <summary>
            {item.q}
            <span class="plus" aria-hidden="true">+</span>
          </summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="cta-section full-bleed">
    <div class="full-bleed-inner cta-inner">
      <h2>Starte dein Abenteuer</h2>
      <p>Lade die kostenlose Sidekik App herunter. ★ {rating} · 2.500+ Piloten.</p>
      <div class="store-badges">
        <a class="store-badge store-badge-accent" href={appStoreUrl} rel="noopener">
          <span class="store-eyebrow">Laden im</span>
          <span class="store-name">App Store</span>
        </a>
        <a class="store-badge" href={playStoreUrl} rel="noopener">
          <span class="store-eyebrow">Jetzt bei</span>
          <span class="store-name">Google Play</span>
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .full-bleed {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
  }

  .full-bleed-inner {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 clamp(20px, 5vw, 48px);
  }

  h2 {
    font-size: clamp(28px, 4.4vw, 38px);
    font-weight: 900;
    text-transform: uppercase;
    margin: 0;
  }

  .eyebrow {
    display: block;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .card {
    background: var(--color-surface);
    border-radius: 22px;
    padding: clamp(22px, 3vw, 30px);
  }

  .card-dark {
    background: var(--color-ink);
    color: #fff;
  }

  .muted-on-dark {
    color: #9ba5b4;
    font-size: 15px;
    line-height: 1.55;
    margin: 0;
  }

  /* Hero */
  .hero {
    background: var(--color-ink);
    color: #fff;
  }

  .hero-inner {
    position: relative;
    overflow: hidden;
    padding-top: 24px;
    padding-bottom: clamp(48px, 7vw, 72px);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: center;
  }

  .hero-relief {
    position: absolute;
    left: -60px;
    bottom: -160px;
    width: 900px;
    max-width: 160%;
    opacity: 0.09;
    pointer-events: none;
  }

  .hero-copy {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 22px;
    align-items: flex-start;
  }

  .rating-pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    border: 1px solid #2a3240;
    padding: 7px 14px;
    border-radius: 8px;
    font-size: 13px;
    color: #b7bec9;
  }

  .rating-pill b {
    color: #fff;
  }

  .hero h1 {
    font-size: clamp(34px, 6vw, 60px);
    line-height: 1;
    letter-spacing: -0.035em;
    font-weight: 900;
    margin: 0;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .accent {
    color: var(--color-primary);
  }

  .hero .lead {
    font-size: clamp(16px, 2vw, 18px);
    line-height: 1.55;
    color: #9ba5b4;
    margin: 0;
    max-width: 470px;
    text-wrap: pretty;
  }

  .store-badges {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .store-badge {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    background: #fff;
    color: var(--color-ink);
    padding: 11px 24px;
    border-radius: 10px;
  }

  .store-badge:hover {
    color: var(--color-ink);
    opacity: 0.9;
  }

  .store-badge-accent {
    background: var(--color-primary);
    color: #fff;
  }

  .store-badge-accent:hover {
    color: #fff;
  }

  .store-eyebrow {
    font-size: 11px;
    opacity: 0.6;
  }

  .store-name {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 800;
  }

  .hero-phones {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .phone {
    width: min(230px, 40vw);
    border-radius: 26px;
    border: 6px solid #232a35;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.5);
    display: block;
  }

  .phone-down {
    transform: translateY(18px);
  }

  .phone-up {
    transform: translateY(-18px);
  }

  /* Why */
  .why {
    padding-top: clamp(40px, 6vw, 64px);
  }

  .why h2 {
    margin-bottom: 24px;
  }

  .why-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .why-card {
    background: var(--color-surface);
    border-radius: 18px;
    padding: 26px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    border-bottom: 4px solid var(--color-primary);
  }

  .why-index {
    font-size: 13px;
    font-weight: 700;
    color: var(--color-primary);
  }

  .why-card p {
    margin: 0;
    font-size: 17px;
    font-weight: 600;
    line-height: 1.4;
  }

  /* Features */
  .feature-section {
    padding-top: clamp(40px, 6vw, 64px);
  }

  .feature-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 16px;
    align-items: stretch;
  }

  .feature-card-tracking {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .chip-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .chip {
    background: var(--color-bg);
    padding: 8px 14px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 500;
  }

  .chip-dark {
    background: var(--color-ink);
    color: #fff;
    font-weight: 600;
    font-size: 13px;
  }

  .tracking-shot {
    width: 100%;
    display: block;
    margin-top: 6px;
    border-radius: 12px;
  }

  .feature-stack {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .feature-stack h3 {
    font-size: 26px;
    font-weight: 800;
    margin: 12px 0 0;
  }

  .card-dark h3 {
    margin-top: 12px;
  }

  .xp-widget {
    background: var(--color-ink-soft);
    border-radius: 12px;
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 4px;
  }

  .xp-row {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 13px;
    color: #9ba5b4;
  }

  .xp-row-small {
    font-size: 12px;
    color: #6f7a8a;
  }

  .xp-bar {
    height: 8px;
    border-radius: 99px;
    background: #232a35;
    overflow: hidden;
  }

  .xp-bar-fill {
    width: 62%;
    height: 100%;
    background: var(--color-primary);
  }

  .feature-card-segments {
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 1;
  }

  .feature-card-segments p {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--color-muted);
  }

  .segments-shot {
    width: 100%;
    max-width: 340px;
    max-height: clamp(300px, 42vh, 480px);
    object-fit: contain;
    object-position: top;
    align-self: center;
    border-radius: 12px;
    display: block;
    margin-top: auto;
  }

  /* Clubs */
  .clubs-section {
    padding-top: clamp(40px, 6vw, 64px);
  }

  .clubs-card {
    border-radius: 24px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 36px;
    align-items: center;
  }

  .clubs-copy {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .clubs-copy h2 {
    font-size: clamp(26px, 4vw, 36px);
    text-wrap: balance;
  }

  .clubs-copy p {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-muted);
    text-wrap: pretty;
  }

  .chip-row-dark .chip-dark {
    padding: 8px 14px;
    border-radius: 8px;
  }

  .text-link {
    font-size: 15px;
    font-weight: 700;
    color: var(--color-primary);
    text-decoration: none;
    margin-top: 4px;
  }

  .leaderboard-widget {
    background: var(--color-ink);
    border-radius: 18px;
    padding: 22px;
    color: #fff;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .leaderboard-head {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    align-items: baseline;
  }

  .leaderboard-title {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 800;
  }

  .leaderboard-sub {
    font-size: 12px;
    color: #6f7a8a;
  }

  .leaderboard-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px;
    background: var(--color-ink-soft);
    border-radius: 10px;
  }

  .leaderboard-row-you {
    background: var(--color-primary);
  }

  .rank {
    width: 26px;
    height: 26px;
    flex: 0 0 auto;
    border-radius: 99px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    font-weight: 700;
    color: var(--color-ink);
  }

  .rank-gold {
    background: #ffc400;
  }

  .rank-silver {
    background: #c9d1db;
  }

  .rank-bronze {
    background: #d2803c;
  }

  .rank-you {
    background: rgba(255, 255, 255, 0.25);
    color: #fff;
  }

  .rank-name {
    flex: 1;
    font-size: 15px;
    font-weight: 600;
  }

