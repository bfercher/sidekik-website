<style>
  .hero {
    padding: 3rem 0 1.5rem;
    text-align: left;
  }
  .hero h1 {
    font-size: 2.4rem;
    max-width: 720px;
  }
  .lead {
    max-width: 620px;
    color: var(--color-muted);
    font-size: 1.1rem;
  }
  .rating {
    color: var(--color-muted);
    font-size: 0.9rem;
  }
  .testimonials {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
  }
  .ratings-strip {
    text-align: center;
    background: var(--color-surface);
    border-radius: 12px;
    padding: 1.5rem;
  }
  .big-rating {
    font-size: 2.5rem;
    font-weight: 800;
    margin: 0;
  }
  .why-list {
    padding-left: 1.2rem;
    display: grid;
    gap: 0.75rem;
  }
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
    margin: 1.5rem 0;
  }
  .feature-grid h3 {
    margin-bottom: 0.4rem;
  }
  .faq details {
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 0.75rem 1rem;
    margin-bottom: 0.6rem;
  }
  .faq summary {
    cursor: pointer;
    font-weight: 600;
  }
  .cta-section {
    text-align: center;
    background: var(--color-surface);
    border-radius: 16px;
    padding: 3rem 1.5rem;
  }
</style>
