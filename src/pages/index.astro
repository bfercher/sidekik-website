---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import heroShot from '../assets/pages/app-screenshots-hero.png';
import { APP, SITE_URL, ratingValueLocalized } from '../lib/seo';

const rating = ratingValueLocalized();

// Each store publishes one decimal on its listing; the extra precision we keep
// in seo.ts is only there so the weighted combined value is accurate.
const storeRating = (value: string) => Number(value).toFixed(1).replace('.', ',');

// Declared on the homepage rather than sitewide because this is the page that
// visibly shows the rating, which is a condition for the rating markup.
const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: APP.name,
  url: SITE_URL,
  applicationCategory: 'SportsApplication',
  operatingSystem: 'iOS, Android',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'EUR',
  },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: APP.ratingValue,
    bestRating: '5',
    ratingCount: APP.ratingCount,
  },
};
---

<Layout
  title="Sidekik | Die App für Gleitschirmpiloten und Clubs"
  description="Tracke deine Hike&Fly- und XC-Abenteuer, setze und erreiche deine fliegerischen Ziele – gemeinsam mit deinen Freunden und Clubkollegen."
  lang="de"
  path="/"
  jsonLd={appSchema}
>
  <section class="hero">
    <h1>Bring dein Gleitschirmfliegen aufs nächste Level.</h1>
    <p class="lead">
      Tracke deine Hike&amp;Fly- und XC-Abenteuer, setze und erreiche deine fliegerischen Ziele –
      gemeinsam mit deinen Freunden und Clubkollegen.
    </p>
    <p><a class="cta-button" href="https://app.sidekik.cloud/signup">Lade die kostenlose Sidekik App herunter</a></p>
    <p class="rating">⭐ {rating} von 5 aus {APP.ratingCount} Bewertungen, Join thousands of Pilots</p>
    <Image
      src={heroShot}
      alt="Sidekik App Screenshots: Feed, Peak-Tracking, Ranking, Fortschritt und Club-Profil"
      class="hero-shot"
      width={960}
      densities={[1, 2]}
      loading="eager"
      fetchpriority="high"
    />
  </section>

  <section class="testimonials">
    <blockquote>
      "Sidekik bringt unsere Piloten im Zillertal weg von den klassischen Rennstrecken, hin zu neuen kreativen Routen und neuen Abenteuern"
      <footer>— Bene Dornauer, Red Bull X-Alps Finisher 2025</footer>
    </blockquote>
    <blockquote>
      "Die Peak Hunt Challenge motiviert mich voll, weil sie mich einfach auf neue Ideen und Berge bringt. Freu mich schon auf den Hike&amp;Fly Herbst"
      <footer>— Nicole Heimberger, österr. XC Staatsmeisterin</footer>
    </blockquote>
    <blockquote>
      "Sidekik hat alle unsere Club-Mitglieder zu besseren Piloten gemacht"
      <footer>— Robert Assmair, Parateam Virgen</footer>
    </blockquote>
  </section>

  <section class="ratings-strip">
    <p>
      Apple App Store {storeRating(APP.stores.apple.ratingValue)} ({APP.stores.apple.ratingCount})
      &nbsp;·&nbsp;
      Google Play {storeRating(APP.stores.google.ratingValue)} ({APP.stores.google.ratingCount})
    </p>
    <p class="big-rating">{rating}</p>
    <p class="rating-count">Gesamt aus {APP.ratingCount} Bewertungen</p>
  </section>

  <section class="why">
    <h2>Warum Sidekik</h2>
    <ol class="why-list">
      <li>Setze dir Ziele und miss den Fortschritt.</li>
      <li>Flüge und Hike&amp;Fly Abenteuer aufzeichnen und teilen.</li>
      <li>Support beim Erreichen deiner Ziele in der Luft</li>
      <li>Fordere deine Kollegen bei spannenden Challenges heraus.</li>
    </ol>
  </section>

  <section class="club-features">
    <h2>Ideal für Clubs und Fliegergemeinschaften</h2>
    <div class="feature-grid">
      <div>
        <h3>Peak Hunt Challenge</h3>
        <p>Fliege zu den höchsten Bergen. Umrunde das Gipfelkreuz. Erlebe Gänsehaut-Momente. Teile das Abenteuer und erhalte Punkte und Badges.</p>
      </div>
      <div>
        <h3>Hike &amp; Fly Challenge</h3>
        <p>Zu Fuß statt mit der Bahn! Entdecke neue Startplätze abseits vom Hausberg. Abwechslung bring neue Erfahrung.</p>
      </div>
      <div>
        <h3>Wettbewerbe (Tasks)</h3>
        <p>Wenn du als Verein interne oder öffentliche Wettbewerbe (Tasks) veranstaltest, kannst du Sidekik zur Auswertung verwenden. Und zwar mit einfachen Modis und einfachem Punktesystem.</p>
      </div>
    </div>
    <p><a href="/clubs">Mehr erfahren</a></p>
  </section>

  <section class="faq">
    <h2>FAQ - alles was du wissen musst, wenn du mit Sidekik fliegst.</h2>
    <details>
      <summary>Welches Equipment brauche ich?</summary>
      <p>Mit der Sidekik App kannst du deine Flüge und Hike&amp;Fly Abenteuer tracken und direkt hochladen. Du kannst aber auch Wegpunkte aus Sidekik exportieren und dein GPS Vario oder andere Flugapps (XC Track, FlySkyHi oder SeeYou Navigator) verwenden. Die .IGC Datei kann dann in der Sidekik App hochgeladen werden, oder du verknüpfst deinen XContest, Garmin Connect oder Suunto Account für automatischen Import.</p>
    </details>
    <details>
      <summary>Ist Sidekik für Piloten kostenlos?</summary>
      <p>Sidekik ist in der Basisversion kostenlos. Es können über ein monatliche oder jährliches Abo zusätzliche Funktionen freigeschalten werden.</p>
    </details>
    <details>
      <summary>Ist Sidekik für Clubs und Vereine kostenlos?</summary>
      <p>Registrierte Mitglieder können kostenlos einen Club erstellen, dessen Mitglieder verwalten und eine Challenge pro Jahr über Sidekik veranstalten. Es gibt jedoch zusätzliche Funktionen, wie Tasks und zusätzliche Auswertungen, die einem Club-Abo unterliegen. Mehr dazu in <a href="/clubs">Für Clubs</a>.</p>
    </details>
    <details>
      <summary>Wie funktioniert die Club-Challenge?</summary>
      <p>Das Konzept ist einfach: Ihr einigt euch als Club auf 15-30 markante Wegpunkte oder Gipfel, welche zu Fuß und/oder fliegend innerhalb eines Zeitraumes erreicht werden müssen. Mit der Sidekik App, oder deinem GPS-Gerät zeichnest du deinen Flug auf und lädst ihn anschließend auf Sidekik hoch. Die Flugdaten werden dann ausgewertet und du bekommst entsprechend Punkte und Bonuspunkte, und siehst dein Ranking im Leaderboard.</p>
      <p><a href="/challenges">Hier gibt's mehr Info dazu.</a></p>
    </details>
    <details>
      <summary>Ist Sidekik nur für erfahrene Piloten?</summary>
      <p>Nein – ganz im Gegenteil. Sidekik ist für alle Pilot:innen mit Lizenz, die regelmäßig fliegen und dabei motiviert bleiben wollen. Egal ob du gerade erst deinen A-Schein gemacht hast oder schon 100+ XC-Flüge hinter dir hast: Wenn du Lust hast, neue Flugziele zu entdecken, Fortschritte zu sehen und deine Abenteuer zu teilen, bist du bei Sidekik genau richtig.</p>
    </details>
    <details>
      <summary>Ich fliege (noch) keine langen XC-Strecken – bringt mir die App trotzdem was?</summary>
      <p>Ja! Du kannst mit Sidekik:</p>
      <ul>
        <li>Hike&amp;Fly-Ziele sammeln</li>
        <li>an Challenges teilnehmen und einfache Gipfel nähe der Startplätze sammeln</li>
        <li>Sidekik als dein Flugbuch verwenden</li>
        <li>deine Höhenmeter, Airtime &amp; Fortschritte verfolgen</li>
        <li>dich von Flügen anderer inspirieren lassen</li>
      </ul>
      <p>Schon kleine Fortschritte werden sichtbar – und motivieren zum Dranbleiben.</p>
    </details>
    <details>
      <summary>Welche Hike&amp;Fly Funktionen gibt es?</summary>
      <p>Wenn du eine Aktivität hochlädst, erkennt Sidekik automatisch, welche Abschnitte du geflogen und welche du zu Fuß zurückgelegt hast. Diese werden auf der Karte farblich unterschiedlich dargestellt. So erhältst du eine eigene Hike&amp;Fly-Statistik, in der Flug- und Gehstrecken – inklusive Distanz, Höhenmeter und Dauer – separat ausgewertet werden.</p>
    </details>
    <details>
      <summary>Kann ich meine Flüge von XContest importieren?</summary>
      <p>Ja, du kannst deine Sidekik Konto mit deinem XContest Konto verbinden und die Flüge von dort importieren. Wichtig ist nur, dass du sie am selben Tag an dem du geflogen bist noch bei XContest einreichst. Ältere Flüge können nicht importiert werden.</p>
    </details>
    <details>
      <summary>Kann ich meine Flüge von DHV XC importieren?</summary>
      <p>Das geht leider noch nicht. Leider gibt es derzeit noch keine Schnittstelle für Drittanbieter, an der Sidekik andocken könnte. Du kannst aber die XContest Verknüpfung verwenden, oder deine Flüge als .IGC oder .GPX Datei hochladen.</p>
    </details>
    <details>
      <summary>Ich verwende eine Fitness Uhr (Garmin, Suunto, etc.) für Hike&amp;Fly Tracking. Wie kann ich diese mit Sidekik verwenden?</summary>
      <p>Es ist möglich, dass du in den App-Einstellungen deinen Garmin Connect oder Suunto Account direkt mit Sidekik verknüpfst. Bei Suunto kannst du nach erfolgreicher Verknüpfung Aktivitäten vom Typ Hike, Paragliding, Trail-Run, Skitour für zukünftige Aktivitäten importieren. Bei Garmin lassen sich Aktivitäten vom Typ Hike, Mountaineering oder Trail-Run importieren.</p>
    </details>
  </section>

  <section class="cta-section">
    <h2>Starte dein Abenteuer!</h2>
    <p>Lade die kostenlose Sidekik App herunter</p>
    <p class="rating">⭐ {rating} von 5 aus {APP.ratingCount} Bewertungen, Join 2500+ Pilots</p>
    <p><a class="cta-button" href="https://app.sidekik.cloud/signup">App herunterladen</a></p>
  </section>
</Layout>

<style>
  .hero {
    padding: 3rem 0 1.5rem;
    text-align: left;
  }
  .hero h1 {
    font-size: 2.4rem;
    max-width: 720px;
  }
  .lead {
    max-width: 620px;
    color: var(--color-muted);
    font-size: 1.1rem;
  }
  .rating {
    color: var(--color-muted);
    font-size: 0.9rem;
  }
  .hero-shot {
    display: block;
    max-width: 100%;
    margin-top: 2rem;
    border-radius: 16px;
  }
  .testimonials {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
  }
  .ratings-strip {
    text-align: center;
    background: var(--color-surface);
    border-radius: 12px;
    padding: 1.5rem;
  }
  .rating-count {
    color: var(--color-muted);
    font-size: 0.85rem;
    margin: 0.25rem 0 0;
  }
  .big-rating {
    font-size: 2.5rem;
    font-weight: 800;
    margin: 0;
  }
  .why-list {
    padding-left: 1.2rem;
    display: grid;
    gap: 0.75rem;
  }
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
    margin: 1.5rem 0;
  }
  .feature-grid h3 {
    margin-bottom: 0.4rem;
  }
  .faq details {
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 0.75rem 1rem;
    margin-bottom: 0.6rem;
  }
  .faq summary {
    cursor: pointer;
    font-weight: 600;
  }
  .cta-section {
    text-align: center;
    background: var(--color-surface);
    border-radius: 16px;
    padding: 3rem 1.5rem;
  }
</style>
