---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import { ORGANIZATION, absoluteUrl, localizedPath } from '../../lib/seo';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, seoTitle, description, pubDate, lang, author, image, imageAlt, flagged } = post.data;
const documentTitle = seoTitle ?? `${title} | Sidekik Blog`;

const dateFormatter = new Intl.DateTimeFormat(lang === 'en' ? 'en-GB' : 'de-DE', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const postUrl = absoluteUrl(`/post/${post.id}`);

// The article body is 720px wide; capping at the source width avoids upscaling
// the few small images (one is only 300px across).
const bodyWidth = image ? Math.min(720, image.width) : 0;

// Social crawlers are inconsistent about WebP, so the preview is forced to JPEG.
const socialSource = image
  ? await getImage({
      src: image,
      width: Math.min(1200, image.width),
      format: 'jpeg',
    })
  : undefined;
const socialImage = socialSource
  ? {
      src: socialSource.src,
      width: Math.min(1200, image!.width),
      height: Math.round((image!.height / image!.width) * Math.min(1200, image!.width)),
    }
  : undefined;

const postSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  inLanguage: lang,
  mainEntityOfPage: { '@type': 'WebPage', '@id': postUrl },
  author: { '@type': 'Person', name: author },
  publisher: {
    '@type': 'Organization',
    name: ORGANIZATION.name,
    logo: { '@type': 'ImageObject', url: absoluteUrl(ORGANIZATION.logo) },
  },
  ...(pubDate ? { datePublished: pubDate.toISOString() } : {}),
  ...(socialImage ? { image: absoluteUrl(socialImage.src) } : {}),
};
---

<Layout
  title={documentTitle}
  description={description}
  lang={lang}
  path={`/post/${post.id}`}
  ogType="article"
  publishedTime={pubDate}
  jsonLd={postSchema}
  ogImage={socialImage}
>
  <article class="post">
    {flagged && (
      <p class="flag-banner">
        ⚠️ This post is flagged for manual review — the automated extraction from the original
        Wix page may not be fully verbatim. Please compare against the live site before treating
        this as final.
      </p>
    )}
    <p class="post-meta">
      {pubDate && <time datetime={pubDate.toISOString()}>{dateFormatter.format(pubDate)}</time>}
      {pubDate && author && <span> · </span>}
      {author && <span>{author}</span>}
    </p>
    <h1>{title}</h1>
    {image && (
      <Image src={image} alt={imageAlt ?? title} width={bodyWidth} densities={[1, 2]} />
    )}
    <div class="post-body">
      <Content />
    </div>
    <p><a href={localizedPath(lang, '/blog')}>&larr; {lang === 'en' ? 'Back to blog' : 'Zurück zum Blog'}</a></p>
  </article>
</Layout>

<style>
  .post {
    max-width: 720px;
    margin: 2rem auto 4rem;
  }
  .post-meta {
    color: var(--color-muted);
    font-size: 0.9rem;
    margin-bottom: 0.25rem;
  }
  .post h1 {
    margin-top: 0.25rem;
  }
  .post img {
    border-radius: 12px;
    margin: 1.5rem 0;
  }
  .post-body :global(h2) {
    margin-top: 2rem;
  }
  .post-body :global(ul),
  .post-body :global(ol) {
    padding-left: 1.4rem;
  }
  .flag-banner {
    background: #fff4e5;
    border: 1px solid #f5c26b;
    color: #7a4b00;
    padding: 0.75rem 1rem;
    border-radius: 8px;
    font-size: 0.9rem;
  }
</style>
