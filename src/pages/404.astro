---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Seite nicht gefunden | Sidekik"
  description="Diese Seite existiert nicht oder wurde verschoben."
  lang="de"
  path="/404"
  noindex
>
  <section class="notfound">
    <p class="code">404</p>
    <h1>Diese Seite gibt es nicht.</h1>
    <p>
      Vielleicht wurde sie verschoben, oder der Link ist nicht mehr aktuell. Von hier kommst du
      weiter:
    </p>
    <ul class="links">
      <li><a href="/">Startseite</a></li>
      <li><a href="/features">Features</a></li>
      <li><a href="/clubs">Für Clubs</a></li>
      <li><a href="/challenges">Challenges</a></li>
      <li><a href="/blog">Blog</a></li>
    </ul>
    <p class="contact">
      Etwas kaputt gefunden? Schreib uns an <a href="mailto:hi@sidekik.cloud">hi@sidekik.cloud</a>.
    </p>
  </section>
</Layout>

<style>
  .notfound {
    max-width: 640px;
    margin: 4rem auto 5rem;
  }
  .code {
    font-size: 3rem;
    font-weight: 800;
    color: var(--color-primary);
    margin: 0;
    line-height: 1;
  }
  .notfound h1 {
    margin: 0.5rem 0 1rem;
  }
  .links {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin: 1.5rem 0;
  }
  .links a {
    text-decoration: none;
    font-weight: 600;
  }
  .contact {
    color: var(--color-muted);
    font-size: 0.9rem;
  }
</style>
